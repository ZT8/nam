+.tabs{position:absolute;bottom:14px;inset-inline:14px;background:rgba(24,24,32,.82);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border:1px solid #2a2a36;border-radius:30px;padding:7px;display:flex;gap:2px;z-index:5}
+.tabs button{flex:1;background:none;border:0;color:#7d7d8b;border-radius:24px;padding:9px 0 8px;font-size:10.5px;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;font-family:inherit;transition:.25s}
+.tabs button b{font-size:19px;font-weight:400;line-height:1}
+.tabs button.on{background:var(--ac);color:#000}
+.foot{text-align:center;color:#4c4c58;font-size:12px;padding:24px 0}
+.toast{position:absolute;top:18px;left:50%;transform:translate(-50%,-80px);background:#fff;color:#000;border-radius:20px;padding:9px 16px;font-size:13px;font-weight:700;z-index:9;transition:.3s}
+.toast.show{transform:translate(-50%,0)}
+.note{color:#888;font-size:13px;text-align:center;max-width:390px}
+
+.orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:0;pointer-events:none;transition:opacity .4s,background .3s}
+.o1{width:300px;height:300px;top:-60px;inset-inline-start:-90px;background:var(--ac)}
+.o2{width:300px;height:300px;top:330px;inset-inline-end:-120px;background:#6a4dff}
+.o3{width:260px;height:260px;bottom:-60px;inset-inline-start:-40px;background:#00b7ff}
+.glass{background:linear-gradient(145deg,#0a0c1c,#101640 55%,#07091a)}
+.glass .orb{opacity:.5}.glass .o3{opacity:.35}.glass .glow{opacity:0}
+.glass .tile,.glass .hero{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(26px) saturate(170%);-webkit-backdrop-filter:blur(26px) saturate(170%);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 8px 24px rgba(0,0,0,.25)}
+.glass .tile.on{background:linear-gradient(145deg,color-mix(in srgb,var(--ac) 88%,#fff 12%),color-mix(in srgb,var(--ac) 62%,transparent));border-color:rgba(255,255,255,.35);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 8px 28px color-mix(in srgb,var(--ac) 35%,transparent)}
+.glass .tile .ico{background:rgba(255,255,255,.10)}
+.glass .tile.on .ico{background:rgba(255,255,255,.28)}
+.glass .pill{background:rgba(255,255,255,.12)}
+.glass .tile.on .pill{background:rgba(0,0,0,.2)}
+.glass .vp,.glass .seg{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
