+    h+=`</div><div class="sec">${T("المطور","DEVELOPER")}</div><div class="grid"><button class="btn wa" data-t="wa">✆ ${T("واتساب","WhatsApp")}</button><button class="btn ig" data-t="ig">◉ @hidestores</button></div>`;
