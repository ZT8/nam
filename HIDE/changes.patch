+static NSArray<NSNumber *> *HIDEAudioLevels(NSURL *file) {
+    AVURLAsset *asset=[AVURLAsset URLAssetWithURL:file options:nil];
+    AVAssetTrack *track=[asset tracksWithMediaType:AVMediaTypeAudio].firstObject;
+    if (!track) return nil;
