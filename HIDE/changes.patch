+.sub{color:#777;font-size:13px;padding:0 4px 14px}
+.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.tile{background:#14141c;border:1px solid #20202b;border-radius:24px;padding:14px;min-height:118px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;transition:transform .12s,background .25s,color .25s;user-select:none;position:relative;overflow:hidden}
+.tile:active{transform:scale(.96)}
+.tile.wide{grid-column:span 2;min-height:88px;flex-direction:row;align-items:center;gap:12px}
+.tile .ico{font-size:21px;width:40px;height:40px;border-radius:14px;background:#22222d;display:grid;place-items:center;flex:none;transition:.25s}
+.tile .tt{font-size:14px;font-weight:700;line-height:1.3}
+.tile .ds{font-size:11px;color:#7a7a88;margin-top:3px;line-height:1.35}
+.tile .tx{flex:1}
+.pill{position:absolute;top:12px;inset-inline-end:12px;font-size:10px;font-weight:800;letter-spacing:.5px;padding:3px 8px;border-radius:10px;background:#22222d;color:#7a7a88;transition:.25s}
+.tile.wide .pill{position:static}
+.tile.on{background:var(--ac);border-color:var(--ac);color:#000}
+.tile.on .ico{background:rgba(0,0,0,.15)}.tile.on .ds{color:rgba(0,0,0,.6)}
+.tile.on .pill{background:rgba(0,0,0,.18);color:#000}
+.tile.act{background:#14141c}
+.tile.act .pill{background:transparent;color:var(--ac);font-size:13px}
