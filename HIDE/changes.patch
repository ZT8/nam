+.ring b{position:absolute;inset:0;display:grid;place-items:center;font-size:24px;font-weight:800}
+.hero .tt{font-size:18px;font-weight:800}.hero .ds{color:#8a8a98;font-size:12px;margin-top:4px;line-height:1.5}
+.sec{font-size:12px;color:#6c6c7a;font-weight:700;padding:18px 6px 8px;letter-spacing:.3px}
+.btn{display:flex;align-items:center;justify-content:center;gap:8px;border-radius:20px;padding:14px;font-weight:700;font-size:14px;cursor:pointer;border:0;font-family:inherit}
+.btn.wa{background:#25d366;color:#052e16}.btn.ig{background:#17171f;border:1px solid #23232e;color:#fff}
+.sw-row{display:flex;gap:10px;padding:2px 4px}
